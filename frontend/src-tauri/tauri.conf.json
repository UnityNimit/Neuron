{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Neuron",
  "version": "1.0.0",
  "identifier": "com.neuron.ide",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Neuron Spatial IDE",
        "width": 1280,
        "height": 720,
        "minWidth": 960,
        "minHeight": 580,
        "resizable": true,
        "maximized": true,
        "center": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "theme": "Dark",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri:; connect-src 'self' ws://127.0.0.1:8000 wss://* http://127.0.0.1:8000 https://*; img-src 'self' data: http://127.0.0.1:8000 asset: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval' 'unsafe-inline' https://cdn.jsdelivr.net; font-src 'self' data: https:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/neuron-backend"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright © 2026 Neuron Team",
    "category": "DeveloperTool",
    "shortDescription": "Full-Stack Spatial Code Intelligence IDE",
    "windows": {
      "nsis": {
        "installerHooks": "hooks.nsh"
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}